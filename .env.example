# Base URL of api-stockline (server-side only; never exposed to the browser).
STOCKLINE_API_URL=http://localhost:5182

# Set to "false" to allow session cookies over plain http (e.g. docker compose on localhost).
# Defaults to secure cookies in production builds.
# COOKIE_SECURE=false

# Xia, the assistant engine (a separate service). The assistant is hidden unless both are set.
# Start it with `npm run dev:xia`. The secret must match the one Xia is started with (min. 32 characters).
# XIA_URL=http://localhost:8901
# XIA_JWT_SECRET=local-dev-xia-signing-key-local-dev-xia-signing-key

# api-careers, behind the Careers module (CV, job offers, applications). The module is hidden unless this is set.
# CAREERS_API_URL=http://localhost:5190
